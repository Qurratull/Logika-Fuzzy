import numpy as np
import matplotlib.pyplot as plt

# 1. FUNGSI KEANGGOTAAN

def trapmf(x, a, b, c, d):
    x = np.asarray(x, dtype=float)

    left = np.ones_like(x) if a == b else np.clip((x-a)/(b-a), 0, 1)
    right = np.where(x <= c, 1.0, 0.0) if c == d else np.clip((d-x)/(d-c), 0, 1)

    return np.minimum(left, right)


def trimf(x, a, b, c):
    x = np.asarray(x, dtype=float)

    return np.maximum(
        0,
        np.minimum(
            np.clip((x-a)/(b-a), 0, 1),
            np.clip((c-x)/(c-b), 0, 1)
        )
    )


# 2. FUZZIFIKASI INPUT

def fuzzy_kendaraan(x):
    return {
        'Sedikit': float(trapmf(x, 0, 0, 20, 50)),
        'Sedang': float(trimf(x, 20, 50, 80)),
        'Banyak': float(trapmf(x, 50, 80, 100, 100))
    }


def fuzzy_antrean(x):
    return {
        'Pendek': float(trapmf(x, 0, 0, 40, 100)),
        'Sedang': float(trimf(x, 40, 100, 160)),
        'Panjang': float(trapmf(x, 100, 160, 200, 200))
    }


def fuzzy_durasi(z):
    return {
        'Singkat': trapmf(z, 10, 10, 20, 35),
        'Sedang': trimf(z, 20, 35, 50),
        'Lama': trapmf(z, 35, 50, 60, 60)
    }


# 3. BASIS ATURAN (9 RULE)

aturan = [
    ('Sedikit', 'Pendek', 'Singkat'),
    ('Sedikit', 'Sedang', 'Singkat'),
    ('Sedikit', 'Panjang', 'Sedang'),
    ('Sedang', 'Pendek', 'Singkat'),
    ('Sedang', 'Sedang', 'Sedang'),
    ('Sedang', 'Panjang', 'Lama'),
    ('Banyak', 'Pendek', 'Sedang'),
    ('Banyak', 'Sedang', 'Lama'),
    ('Banyak', 'Panjang', 'Lama')
]


# 4. INFERENSI MAMDANI + CENTROID

def evaluasi(kendaraan, antrean):
    if not 0 <= kendaraan <= 100:
        raise ValueError('Jumlah kendaraan harus 0-100')

    if not 0 <= antrean <= 200:
        raise ValueError('Panjang antrean harus 0-200 meter')

    mu_k = fuzzy_kendaraan(kendaraan)
    mu_a = fuzzy_antrean(antrean)

    z = np.linspace(10, 60, 1001)
    mu_z = fuzzy_durasi(z)

    agregasi = np.zeros_like(z)
    alpha_list = []

    for k, a, hasil in aturan:
        alpha = min(mu_k[k], mu_a[a])  # operator AND: MIN
        alpha_list.append(alpha)

        implikasi = np.minimum(alpha, mu_z[hasil])  # implikasi: MIN
        agregasi = np.maximum(agregasi, implikasi)  # agregasi: MAX

    luas = np.sum(agregasi)

    if luas == 0:
        raise ValueError('Tidak ada aturan fuzzy yang aktif')

    centroid = np.sum(z * agregasi) / luas

    kategori_mu = {
        nama: float(mf(centroid))
        for nama, mf in {
            'Singkat': lambda x: trapmf(x, 10, 10, 20, 35),
            'Sedang': lambda x: trimf(x, 20, 35, 50),
            'Lama': lambda x: trapmf(x, 35, 50, 60, 60)
        }.items()
    }

    kategori = max(kategori_mu, key=kategori_mu.get)

    return centroid, kategori, z, agregasi, alpha_list


# 5. PENGUJIAN 5 SKENARIO

if __name__ == '__main__':

    data_uji = [
        (10, 30),
