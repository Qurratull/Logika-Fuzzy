# 8. DECISION SURFACE 3D

krange = np.linspace(0, 100, 25)
arange = np.linspace(0, 200, 25)

X, Y = np.meshgrid(krange, arange)
Z = np.zeros_like(X)

for i in range(X.shape[0]):
    for j in range(X.shape[1]):
        Z[i, j] = evaluasi(X[i, j], Y[i, j])[0]


fig = plt.figure(figsize=(9, 6))

ax = fig.add_subplot(111, projection='3d')

ax.plot_surface(X, Y, Z, edgecolor='none')

ax.set_xlabel('Jumlah kendaraan')
ax.set_ylabel('Panjang antrean (meter)')
ax.set_zlabel('Durasi hijau (detik)')

ax.set_title('Decision Surface Durasi Lampu Hijau')

